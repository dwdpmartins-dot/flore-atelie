# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Identity Services ("Sign in with Google" on AuthGate) -- the OAuth
# Client ID configured in Supabase's Google provider (safe to expose
# client-side; it's not the secret). That Client ID's "Authorized
# JavaScript origins" in Google Cloud Console must include this site's own
# origin (https://floreatelie.com.br, plus http://localhost:3000 for local
# dev) -- see lib/auth/googleIdentity.ts for why this exists instead of
# Supabase's redirect-based signInWithOAuth.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Mercado Pago (Checkout Transparente / Payment Bricks)
# Public key is used client-side by the Payment Bricks SDK.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Shared secret to validate MP webhook signatures.
MERCADOPAGO_WEBHOOK_SECRET=

# OpenAI (bouquet illustration generation, admin-toggleable)
OPENAI_API_KEY=

# Resend (transactional email — order/subscription confirmations, declines,
# welcome, admin notifications). floreatelie.com.br must be verified on the
# Resend account (SPF/DKIM) for the "contato@floreatelie.com.br" From
# address to actually deliver. If unset, sendEmail() logs and no-ops instead
# of throwing — nothing else breaks, emails just don't go out.
RESEND_API_KEY=

# Used to build absolute links inside emails (and Mercado Pago's back_url).
# Defaults to https://floreatelie.com.br if unset.
NEXT_PUBLIC_SITE_URL=

# Geocoding (ViaCEP needs no key; Nominatim requires a descriptive User-Agent per its usage policy)
NOMINATIM_USER_AGENT="FloreAtelie/1.0 (contato@floreatelie.com.br)"
# Ateliê's own address, used as the shipping-distance origin.
ATELIER_CEP=
ATELIER_ADDRESS="Rua das Flores, 1 - São Paulo, SP"

# Cron
# Vercel Cron sends this as a bearer token so the endpoint can't be hit publicly.
CRON_SECRET=

# Meta Pixel (Facebook/Instagram Ads conversion tracking)
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 (traffic + Google Ads conversion base)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
